# ─── REQUIRED ─────────────────────────────────────────────────────────────────

# JWT secret for session signing (min 32 chars, random string)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-secure-random-secret-min-32-chars

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────

# Node environment (set to "production" on Render.com)
NODE_ENV=development

# ─── NOTES ────────────────────────────────────────────────────────────────────
# DO NOT use NEXT_PUBLIC_ prefix for any secrets — those values are
# bundled into the client-side JavaScript bundle and are visible to all users.
#
# The SQLite database path is derived from process.cwd()/data/app.db
# No DATABASE_URL is needed for SQLite.
#
# Uploaded files are stored at public/uploads/evidence/
# Ensure this path is writable by the web process on your host.
